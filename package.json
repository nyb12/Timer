{
  "name": "timer-corner-app",
  "version": "1.0.0",
  "description": "Bottom-right Mac countdown timer app.",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node app.test.mjs",
    "dist": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.local.timer",
    "productName": "Timer",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "main.cjs",
      "dragon-studio-clock-ticking-sfx-467486.mp3"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    }
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  }
}
